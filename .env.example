# Estas variables se exportan al entorno; manage.py no lee .env automáticamente.
# PostgreSQL (opcional en desarrollo):
# DATABASE_URL=postgresql://eventia:CAMBIAR_PASSWORD@127.0.0.1:5432/eventia
EVENTIA_ORIGIN=http://127.0.0.1:8000
COOKIE_SECURE=0
# En HTTPS configurar COOKIE_SECURE=1 y EVENTIA_ORIGIN=https://tu-dominio
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=eventia@example.com
# SMTP_USER=...
# SMTP_PASSWORD=...
