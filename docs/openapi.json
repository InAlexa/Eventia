            "cookieSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Perfil"
                }
              }
            }
          },
          "401": {
            "description": "Sesión ausente o credenciales incorrectas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Rol, propiedad, CSRF u origen no autorizado.",
            "content": {
