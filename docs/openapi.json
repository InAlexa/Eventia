    "/api/auth/me": {
      "get": {
        "summary": "Consultar sesión y token CSRF",
        "description": "Público. Sin sesión ambos valores son null. Con sesión retorna perfil propio con rol y token CSRF; nunca hash.",
        "security": [],
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "usuario": {
                      "anyOf": [
